# Environment variables of the video processor, with DEVELOPMENT values only.
# Never put real credentials in this file or commit a .env file (.env is
# gitignored).
#
# Nothing here is required to run the local stack: deploy/docker-compose.yml
# has the same defaults built in (${VAR:-default}).
#
# - To override the compose stack: copy this file to deploy/.env (compose
#   reads .env from the compose file's directory) and edit it.
# - To run a service from the host against the stack (`make up` first):
#     cp .env.example .env && set -a && . ./.env && set +a && go run ./cmd/api

# --- Compose stack (deploy/docker-compose.yml) -------------------------------

# PostgreSQL superuser and database created on first start.
POSTGRES_USER=video
POSTGRES_PASSWORD=video
POSTGRES_DB=video_processor

# RabbitMQ user created on first start. RABBITMQ_ERLANG_COOKIE is written to
# /var/lib/rabbitmq/.erlang.cookie on every boot (with the right permissions)
# instead of being generated once and left in the volume, where a stale or
# wrongly-permissioned leftover file makes the node refuse to start with
# "Error when reading /var/lib/rabbitmq/.erlang.cookie: eacces" — seen on a
# clean CI volume, not just here. Any string works for a single node; change
# it for a real cluster.
RABBITMQ_USER=video
RABBITMQ_PASSWORD=video
RABBITMQ_ERLANG_COOKIE=dev-only-erlang-cookie-change-me

# Host ports the infrastructure is published on (127.0.0.1 only). The API
# (8080) and the MailHog UI/API (8025) are fixed: the integration tests use
# them.
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
# RabbitMQ's Prometheus endpoint (rabbitmq_prometheus plugin).
RABBITMQ_METRICS_PORT=15692
S3_PORT=8333
MAILHOG_SMTP_PORT=1025

# Observability (docs/observability.md, "Prometheus", "Grafana"). Both start
# with the stack. Prometheus UI on 127.0.0.1:9091 (not 9090, the api's
# internal metrics port); how long it keeps samples.
PROMETHEUS_PORT=9091
PROMETHEUS_RETENTION=2d
# Grafana on 127.0.0.1:3000. The dashboard is open read-only to anonymous
# visitors (local demo; set false to require a login). Admin login below:
# development values only, like everything in this file.
GRAFANA_PORT=3000
GRAFANA_ANONYMOUS_ENABLED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Grafana server log level (debug, info, warn, error).
GRAFANA_LOG_LEVEL=warn

# Optional Go module proxy used when building the service images (empty:
# https://proxy.golang.org,direct).
GOPROXY=
# Version of the service images, reported by the videoproc_build_info metric.
VERSION=dev

# --- api service (internal/platform/config) ----------------------------------
# In the compose stack the api gets DATABASE_URL, AMQP_URL and S3_ENDPOINT
# pointing at the other containers; the values below are for running it
# from the host.

# Listen address (host:port).
HTTP_ADDR=:8080
# Internal listener of GET /metrics (Prometheus, docs/observability.md);
# keep it off the public network. (The worker and the notifier serve
# /metrics on HEALTH_ADDR.)
METRICS_ADDR=:9090
# debug, info, warn or error. Logs are JSON on stdout.
LOG_LEVEL=info
# Grace period for in-flight requests after SIGINT/SIGTERM.
SHUTDOWN_TIMEOUT=15s
# Timeout of each dependency check of GET /readyz.
READINESS_TIMEOUT=2s

# PostgreSQL connection URL (required). URL-encode special characters in the
# password.
DATABASE_URL=postgres://video:video@localhost:5432/video_processor?sslmode=disable

# RabbitMQ connection URL (required).
AMQP_URL=amqp://video:video@localhost:5672/

# S3-compatible object storage (SeaweedFS locally; MinIO or AWS S3 work too).
# S3_ENDPOINT is host:port or http(s)://host:port. S3_ACCESS_KEY and
# S3_SECRET_KEY are required; in the compose stack they also configure the
# storage service's credentials.
S3_ENDPOINT=localhost:8333
S3_ACCESS_KEY=dev-access-key
S3_SECRET_KEY=dev-secret-key
S3_BUCKET=videos
S3_REGION=us-east-1
S3_USE_SSL=false

# Access tokens (HS256 JWT). JWT_SECRET is required, at least 32 bytes, and
# shared by every api replica; generate one with `openssl rand -base64 48`.
# The value below is for local development only.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789
# Lifetime of an access token (Go duration, at least 1s).
JWT_TTL=1h

# Largest upload request in bytes (default 1 GiB); larger ones get 413.
MAX_UPLOAD_BYTES=1073741824
# Where uploads are spooled while received (empty: the system temp dir).
UPLOAD_TEMP_DIR=
# Outbox relay (ADR 0004): poll interval (uploads also wake it up at once)
# and messages per relay transaction (1 to 500).
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100

# Redis cache of GET /api/v1/videos (docs/cache.md): redis:// or rediss://
# URL; empty disables the cache. Best effort: when Redis is unreachable the
# api reads Postgres. The worker needs the same REDIS_URL, since it
# invalidates the cache on every status change. In compose, setting it to
# empty (REDIS_URL=) disables the cache in both services.
REDIS_URL=redis://localhost:6379/0
# How long a cached page lives; it also bounds how stale a page can get if
# an invalidation is lost while Redis is unreachable.
CACHE_TTL=30s

# --- worker service (internal/platform/config, Worker) -----------------------
# Uses LOG_LEVEL, READINESS_TIMEOUT, DATABASE_URL, AMQP_URL, S3_*, REDIS_URL
# and OUTBOX_* above (the worker relays its video.failed / video.processed
# events through the outbox too).
# To run one from the host: go run ./cmd/worker (needs ffmpeg in PATH).

# Where GET /healthz, /readyz and /metrics are served (internal only).
HEALTH_ADDR=:8081
# Videos processed at the same time by one worker (also the prefetch count).
WORKER_CONCURRENCY=2
# Attempts per job before its video ends FAILED; 0 means the maximum the
# retry queues allow (4: retries after 2s, 10s and 30s).
WORKER_MAX_ATTEMPTS=0
# Longest frame extraction of one video; past it the video ends FAILED.
FFMPEG_TIMEOUT=10m
# Where jobs keep their temporary files (empty: the system temp dir).
WORKER_TEMP_DIR=
# In compose, the worker's SHUTDOWN_TIMEOUT (in-flight jobs may finish for
# this long after SIGTERM, then they are requeued) comes from:
WORKER_SHUTDOWN_TIMEOUT=15s
# Compose only: worker containers (processing slots = WORKER_REPLICAS x
# WORKER_CONCURRENCY; the integration suite needs at least 2).
WORKER_REPLICAS=2

# --- notifier service (internal/platform/config, Notifier) -------------------
# Failure e-mails (RF5, docs/notifications.md). Uses LOG_LEVEL,
# READINESS_TIMEOUT, DATABASE_URL, AMQP_URL and HEALTH_ADDR above (when
# running it next to a worker from the host, give it another HEALTH_ADDR,
# e.g. HEALTH_ADDR=:8082 go run ./cmd/notifier).

# E-mails sent at the same time (also the prefetch count).
NOTIFIER_CONCURRENCY=4
# Attempts per e-mail before its event goes to video.notify.dlq; 0 means the
# maximum the retry queues allow (5: retries after 10s, 1m, 5m and 15m).
NOTIFIER_MAX_ATTEMPTS=0
# In compose, the notifier's SHUTDOWN_TIMEOUT comes from:
NOTIFIER_SHUTDOWN_TIMEOUT=15s
# Link to the web UI written in the e-mails.
APP_URL=http://localhost:8080

# SMTP server. The defaults target MailHog (compose: mailhog:1025; from the
# host: localhost:1025) with no TLS and no authentication. In production
# use the provider's submission endpoint, e.g.
#   SMTP_HOST=smtp.example.com SMTP_PORT=587 SMTP_TLS=starttls
#   SMTP_USERNAME=apikey SMTP_PASSWORD=<secret from your secret store>
# SMTP_TLS: none (plain SMTP), starttls (required STARTTLS upgrade, port
# 587) or tls (implicit TLS, port 465). Authentication (PLAIN) is used when
# SMTP_USERNAME is set and requires starttls or tls.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="FIAP X Video Processor <no-reply@fiapx.local>"
SMTP_TLS=none
# Bound on sending one e-mail (connect, SMTP commands, data).
SMTP_TIMEOUT=30s
