# Non-secret configuration shared by api, worker and notifier
# (internal/platform/config). Mounted as the "app-config" ConfigMap via
# configMapGenerator (base/kustomization.yaml) and consumed with envFrom.
#
# Values mirror the defaults deploy/docker-compose.yml sets for the same
# services; see .env.example for what each variable does. Per-service
# listen addresses (HTTP_ADDR, METRICS_ADDR, HEALTH_ADDR) are NOT here:
# they are fixed by the container's EXPOSE'd ports and set directly on
# each Deployment, exactly as compose does.
LOG_LEVEL=info
READINESS_TIMEOUT=2s
SHUTDOWN_TIMEOUT=15s

# S3-compatible object storage (in-cluster SeaweedFS; see infra/storage).
S3_ENDPOINT=storage.video-processor.svc.cluster.local:8333
S3_BUCKET=videos
S3_REGION=us-east-1
S3_USE_SSL=false

# Access tokens.
JWT_TTL=1h

# Uploads and the outbox relay (ADR 0004).
MAX_UPLOAD_BYTES=1073741824
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100

# Redis cache of GET /api/v1/videos (docs/cache.md).
REDIS_URL=redis://redis.video-processor.svc.cluster.local:6379/0
CACHE_TTL=30s

# worker (internal/platform/config.Worker)
WORKER_CONCURRENCY=2
WORKER_MAX_ATTEMPTS=0
FFMPEG_TIMEOUT=10m

# notifier (internal/platform/config.Notifier), SMTP pointed at the
# in-cluster MailHog (see infra/mailhog); swap for a real provider's
# submission endpoint in a managed deployment (see README).
NOTIFIER_CONCURRENCY=4
NOTIFIER_MAX_ATTEMPTS=0
APP_URL=http://localhost:8080
SMTP_HOST=mailhog.video-processor.svc.cluster.local
SMTP_PORT=1025
SMTP_FROM=FIAP X Video Processor <no-reply@fiapx.local>
SMTP_TLS=none
SMTP_TIMEOUT=30s
