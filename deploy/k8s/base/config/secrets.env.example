# Placeholder secret values — DEVELOPMENT ONLY, same as .env.example.
#
# This file is committed so `kubectl kustomize` / `kubectl apply -k` work
# out of the box for local (kind) testing, exactly like the compose stack's
# built-in ${VAR:-default}s. Consumed via secretGenerator (see
# base/kustomization.yaml) into a Secret named "app-secrets".
#
# *** Never put real credentials in this file. ***
#
# Before applying to a real cluster:
#   1. cp deploy/k8s/base/config/secrets.env.example deploy/k8s/overlays/prod/secrets.env
#   2. Edit deploy/k8s/overlays/prod/secrets.env with real values (a random
#      JWT_SECRET via `openssl rand -base64 48`, the real DB/AMQP/S3/SMTP
#      credentials).
#   3. deploy/k8s/overlays/prod/kustomization.yaml already points its
#      secretGenerator at that file (see the comment there). secrets.env is
#      gitignored (deploy/k8s/.gitignore) so it is never committed.
#   4. Prefer swapping this whole mechanism for your cluster's secret
#      manager (Sealed Secrets, External Secrets Operator, SOPS, the cloud
#      provider's secret store) instead of a plain Kubernetes Secret, which
#      is only base64-encoded, not encrypted at rest by default.

# PostgreSQL (in-cluster StatefulSet, infra/postgres) and the URL the api,
# worker and migrate Job connect with.
POSTGRES_USER=video
POSTGRES_PASSWORD=video
POSTGRES_DB=video_processor
DATABASE_URL=postgres://video:video@postgres.video-processor.svc.cluster.local:5432/video_processor?sslmode=disable

# RabbitMQ (in-cluster StatefulSet, infra/rabbitmq) and the URL api, worker
# and notifier connect with.
RABBITMQ_USER=video
RABBITMQ_PASSWORD=video
AMQP_URL=amqp://video:video@rabbitmq.video-processor.svc.cluster.local:5672/

# S3-compatible object storage (in-cluster SeaweedFS, infra/storage).
S3_ACCESS_KEY=dev-access-key
S3_SECRET_KEY=dev-secret-key

# Access tokens (HS256 JWT), at least 32 bytes, shared by every api
# replica.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789

# SMTP auth (MailHog needs none; set both for a real provider).
SMTP_USERNAME=
SMTP_PASSWORD=
